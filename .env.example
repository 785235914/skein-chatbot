NODE_ENV=development
PORT=3000
DEMO_PORT=5173
LOG_LEVEL=info

DATABASE_URL=

ORCHESTRATOR_PROVIDER=mock
DIFY_BASE_URL=
DIFY_API_KEY=
DIFY_PROFILE=default

DEFAULT_MODE=quick
QUICK_TIMEOUT_MS=25000
DEEP_TIMEOUT_MS=60000
