{
  "name": "skein-chatbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm -r --sort --if-present run build",
    "dev": "pnpm --filter @skein-chatbot/api dev",
    "dev:mock": "cross-env ORCHESTRATOR_PROVIDER=mock pnpm --parallel --filter @skein-chatbot/api --filter @skein-chatbot/demo-web dev",
    "dev:dify": "cross-env ORCHESTRATOR_PROVIDER=dify pnpm --parallel --filter @skein-chatbot/api --filter @skein-chatbot/demo-web dev",
    "db:generate": "pnpm --filter @skein-chatbot/postgres prisma:generate",
    "db:migrate": "pnpm --filter @skein-chatbot/postgres prisma:migrate",
    "smoke:dify": "tsx scripts/smoke-dify.ts",
    "scrub": "tsx scripts/open-source-scrub.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.10.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "tldts": "^7.4.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.8"
  }
}
